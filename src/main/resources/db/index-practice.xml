<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                      http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.3.xsd">

    <!-- Индекс для поиска по имени студента -->
    <changeSet id="add-student-name-index" author="ваше_имя">
        <createIndex tableName="student" indexName="idx_student_name">
            <column name="name"/>
        </createIndex>
    </changeSet>

    <!-- Индекс для поиска по названию и цвету факультета -->
    <changeSet id="add-faculty-name-color-index" author="ваше_имя">
        <createIndex tableName="faculty" indexName="idx_faculty_name_color">
            <column name="name"/>
            <column name="color"/>
        </createIndex>
    </changeSet>
</databaseChangeLog>